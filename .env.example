# Postgres connection string used by the app at runtime. Works with the
# local docker-compose Postgres, a Neon connection string, or any other
# Postgres host. Swapping hosts is just changing this value.
#
# On a serverless host every invocation opens its own connection, so use a
# POOLED string there (on Neon the hostname contains "-pooler").
DATABASE_URL="postgresql://spotthevuln:spotthevuln@localhost:5433/spotthevuln?schema=public"

# Connection used only by `prisma migrate`. Migrations need session-level
# advisory locks, which transaction pooling does not support, so this must
# bypass the pooler (on Neon: the same string without "-pooler").
# Running against a non-pooled Postgres? Set it to the same value as above.
DIRECT_URL="postgresql://spotthevuln:spotthevuln@localhost:5433/spotthevuln?schema=public"

# Signs the visitor session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

# Minutes an in-progress attempt can sit idle before it's considered stale
# and the visitor is asked to restart instead of silently resuming.
ATTEMPT_STALE_MINUTES=20
